## Standard Starter Template

> **Note**: This template focuses on the Bark & Progression layer. When authoring an entirely new custom NPC from scratch, ensure you also include the root bio fields (`Biography`, `Relationships`, `Traits`, and a root-level `Preoccupations` fallback array).

{
  "Changes": [
    {
      "Action": "EditData",
      "Target": "ValleyTalkReborn/Bios/NPCName",
      "Priority": "Early",
      "Entries": {
        "ProgressStates": [
          {
            "RequireMarried": true,
            "Text": "Third-person physical actions in the farmhouse (use positive framing).",
            "BarkMindset": "[STAGE: MARRIED LIFE]\n- Mindset: Domestic security, settled comfort, fully open to shared routines.\n- Attention Flow: Morning chores, crops, livestock movements, shared quiet life.",
            "Preoccupations": [
              "Stage item one",
              "Stage item two",
              "Stage item three",
              "Stage item four"
            ]
          },
          {
            "RequiredHearts": 7,
            "Text": "Third-person actions showing deep trust and relaxed physical posture.",
            "BarkMindset": "[STAGE: SINCERE TRUST]\n- Mindset: Lowered personal guard, willing vulnerability, genuine mutual respect.\n- Attention Flow: Future aspirations, family responsibilities, companionable presence.",
            "Preoccupations": [
              "Stage item one",
              "Stage item two",
              "Stage item three",
              "Stage item four"
            ]
          },
          {
            "RequiredHearts": 3,
            "Text": "Third-person actions showing emerging acquaintance and softening barriers.",
            "BarkMindset": "[STAGE: BUDDING RAPPORT]\n- Mindset: Practical curiosity, peer acknowledgment, cautious warmth.\n- Attention Flow: Shared work realities, local town gossip, noting the farmer nearby.",
            "Preoccupations": [
              "Stage item one",
              "Stage item two",
              "Stage item three",
              "Stage item four"
            ]
          },
          {
            "RequiredHearts": 0,
            "Text": "Third-person actions showing physical distance and emotional guarding (zero negative words).",
            "BarkMindset": "[STAGE: EARLY GUARDED POSTURING]\n- Mindset: Core defense mechanism active, viewing the farmer as an unfamiliar stranger.\n- Attention Flow: Immediate personal tasks, physical fatigue, local boredom, self-preservation.",
            "Preoccupations": [
              "Stage item one",
              "Stage item two",
              "Stage item three",
              "Stage item four"
            ]
          }
        ],

        "EnableAmbientBarks": true,
        "AmbientBarkPrompt": {
          "VoiceAndAttitude": "Permanent identity, vocal resonance, physical archetype, and social instincts.",
          "SpokenHabits": "Sentence pacing, fillers, greetings, and typical conversational tempo (strictly positive framing).",
          "ObservationLenses": "- Sensory Domain 1: Observable physical properties, wear, and structural details.\n- Sensory Domain 2: Materials, tools, environmental surfaces, and immediate workload.\n- Sensory Domain 3: Atmospheric conditions, regional weather effects, and footing.\n- Sensory Domain 4: Social spaces, routine tasks, and surrounding physical traffic."
        }
      }
    }
  ]
}
```

