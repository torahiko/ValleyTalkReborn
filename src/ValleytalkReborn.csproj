<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>2.0.2</Version>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <GamePath>H:\ValleytalkReborn\Stardew Valley</GamePath>
    <EnableHarmony>true</EnableHarmony>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <ModFolderName>ValleyTalkReborn</ModFolderName>
    <Authors>srkgou/dandm1</Authors>
    <PackageId>ValleytalkReborn</PackageId>
    <Product>ValleytalkReborn</Product>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/_</PathMap>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- 强制将 NuGet 依赖 DLL（FontStashSharp.* 等）复制到输出/Mods 目录，
         否则 SMAPI 运行时因找不到依赖而报 "DLL couldn't be loaded" -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FontStashSharp.MonoGame" Version="1.3.9" />
    <PackageReference Include="newtonsoft.json" Version="13.0.5-beta1" />
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
    <PackageReference Include="TextCopy" Version="6.2.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.json">
      <Link>%(Filename)%(Extension)</Link> 
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="i18n/**">
      <Link>i18n/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="assets/**">
      <Link>assets/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- FONT-01-r2: 显式包含 UI/assets/fonts/ 下的字体与许可文件 -->
    <None Update="UI\assets\fonts\*.ttf">
      <Link>assets\fonts\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="UI\assets\fonts\*.txt">
      <Link>assets\fonts\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Remove="Actions\Movement\MovementManager.cs.new" />
    <None Remove="Actions\Movement\MovementManager.cs.bak" />
    <None Remove="Dialogue\Ambient\Bark\BarkPromptBuilder.cs.bak" />
  </ItemGroup>

  <ItemGroup>
    <ContentPacks Include="../ContentPack" FolderName="[CP] ValleyTalkReborn Base" Version="$(Version)" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="UI\assets\FullSpritesheet.png" />
    <EmbeddedResource Include="UI\assets\textures\Button.png" />
  </ItemGroup>
</Project>