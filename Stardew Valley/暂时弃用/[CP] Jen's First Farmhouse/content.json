{
  "Format": "2.0.0",
  "ConfigSchema": {
    "Enable": {
      "AllowValues": "true, false",
      "Default": "true"
    },
    "Remove Kitchen": {
      "AllowValues": "true, false",
      "Default": "false",
      "Description": "Empty out your fridge before selecting this option or else you will lose everything in it!",
    }
  },
  "Changes": [
// Load Maps
    {
      "Action": "Load",
      "Target": "Maps/FarmHouse2, Maps/FarmHouse2_marriage",
      "FromFile": "assets/{{TargetWithoutPath}}.tmx",
      "When": {
        "Enable": true,
 	"Remove Kitchen": false
      }
    },
    {
      "Action": "Load",
      "Target": "Maps/FarmHouse2, Maps/FarmHouse2_marriage",
      "FromFile": "assets/{{TargetWithoutPath}}_NoKitchen.tmx",
      "When": {
        "Enable": true,
 	"Remove Kitchen": true
      }
    },
// Load Renovations
    {
      "Action": "Load",
      "Target": "Maps/FarmHouse_Crib_0, Maps/FarmHouse_Crib_1, Maps/FarmHouse_CornerRoom_Add, Maps/FarmHouse_CornerRoom_Remove, Maps/FarmHouse_DiningRoom_Add, Maps/FarmHouse_FarUpperRoom_Add, Maps/FarmHouse_FarUpperRoom_Remove, Maps/FarmHouse_DiningRoomWall_Add, Maps/FarmHouse_DiningRoomWall_Remove, Maps/FarmHouse_Bedroom_Normal, Maps/FarmHouse_Bedroom_Open, Maps/FarmHouse_Cubby_Add, Maps/FarmHouse_Cubby_Remove, Maps/FarmHouse_ExtendedCornerRoom_Add, Maps/FarmHouse_ExtendedCornerRoom_Remove, Maps/FarmHouse_SouthernRoom_Add, Maps/FarmHouse_SouthernRoom_Remove",
      "FromFile": "assets/{{TargetWithoutPath}}.tmx",
      "When": {
        "Enable": true
      }
    },
    {
      "Action": "Load",
      "Target": "Maps/FarmHouse_DiningRoom_Remove",
      "FromFile": "assets/{{TargetWithoutPath}}.tmx",
      "When": {
        "Enable": true,
	"Remove Kitchen": false
      }
    },
    {
      "Action": "Load",
      "Target": "Maps/FarmHouse_DiningRoom_Remove",
      "FromFile": "assets/{{TargetWithoutPath}}_NoKitchen.tmx",
      "When": {
        "Enable": true,
	"Remove Kitchen": true
      }
    },
// Screenshot Region
    {
      "Action": "EditMap",
      "Target": "Maps/FarmHouse2, Maps/FarmHouse2_marriage",
      "MapProperties": {
        "ScreenshotRegion": "9 1 56 40"
      },
      "When": {
        "Enable": true
      }
    },
// Cellar Fix
    {
      "Action": "Load",
      "Target": "Maps/FarmHouse_Cellar",
      "FromFile": "assets/Cellar_Fix.tmx",
      "When": {
        "Enable": true
      }
    },
// Cellar Warp Fix
    {
      "Action": "EditMap",
      "Target": "Maps/Cellar",
      "MapProperties": {
        "Warp": "3 1 FarmHouse 21 29 4 1 FarmHouse 22 29"
      },
      "When": {
        "Enable": true
      }
    },
// Greenhouse Property
    {
      "Action": "EditMap",
      "Target": "Maps/FarmHouse2, Maps/FarmHouse2_marriage",
      "MapProperties": {
        "IsGreenhouse": true
      },
      "When": {
        "Enable": true
      }
    },
// Renovation Strings
    {
      "Action": "EditData",
      "Target": "Strings/Locations",
      "Entries": {
        "ScienceHouse_Renovation_AddSouthernRoom": "{{i18n:Jen.FirstFarmhouse_AddHallway}}",
        "ScienceHouse_Renovation_RemoveSouthernRoom": "{{i18n:Jen.FirstFarmhouse_RemoveHallway}}"
      },
      "When": {
        "Enable": true
      }
    },
    {
      "Action": "EditData",
      "Target": "Strings/1_6_Strings",
      "Entries": {
        "Renovation_AddExtendedCornerRoom": "{{i18n:Jen.FirstFarmhouse_AddGreenhouse}}",
        "Renovation_RemoveExtendedCornerRoom": "{{i18n:Jen.FirstFarmhouse_RemoveGreenhouse}}"
      },
      "When": {
        "Enable": true
      }
    },
