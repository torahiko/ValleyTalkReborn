{
"Changes": [

//TRIGGER ACTIONS
{
   "Action": "EditData",
   "Target": "Data/TriggerActions",
   "Entries": {

    "{{ModId}}_Reset1": {
        "Id": "{{ModId}}_Reset1",
        "Trigger": "DayEnding",
        "Condition": "PLAYER_HAS_MAIL Current {{ModId}}_GiftReceived",
        "MarkActionApplied": false,
        "Actions": [
            "RemoveMail Current {{ModId}}_GiftReceived",
        ]
    },
    
    "{{ModId}}_ResetQuests": {
        "Id": "{{ModId}}_ResetQuests",
        "Trigger": "DayStarted",
        "Condition": "PLAYER_HAS_MAIL Current {{ModId}}_WinterQuest, !SEASON winter",
        "MarkActionApplied": false,
        "Actions": [
            "RemoveMail Current {{ModId}}_WinterQuest",
        ]
    },
       
    //Two triggers bounce back and forth (poor/rich)
    "{{ModId}}_Poor": {
        "Id": "{{ModId}}_Poor",
        "Trigger": "LocationChanged",
        "Condition": "PLAYER_CURRENT_MONEY Current 0 200",
        "Actions": [
            "AddMail Current {{ModId}}_Poor Received",
            "RemoveMail Current {{ModId}}_Rich",
            "MarkActionApplied Current {{ModId}}_Rich false",
            
            "AddConversationTopic {{ModId}}_Topic_Poor 1",
        ]
    },
                
    "{{ModId}}_Rich": {
        "Id": "{{ModId}}_Rich",
        "Trigger": "LocationChanged",
        "Condition": "PLAYER_CURRENT_MONEY Current 201",
        "Actions": [
            "AddMail Current {{ModId}}_Rich Received",
            "RemoveMail Current {{ModId}}_Poor",
            "MarkActionApplied Current {{ModId}}_Poor false",
        ]
    },
    
    //Add some special flags
    "{{ModId}}_NewlyWed": {
        "Id": "{{ModId}}_NewlyWed",
        "Trigger": "DayStarted",
        "Condition": "PLAYER_NPC_RELATIONSHIP Current Any Married",
        "Actions": [
            "AddMail Current {{ModId}}_NewlyWed Received",
        ]
    },
   
   "{{ModId}}_FirstDeath": {
       "Id": "{{ModId}}_FirstDeath",
       "Trigger": "DayEnding",
       "Condition": "PLAYER_STAT Current timesUnconscious 1",
       "Actions": [
           "AddMail Current {{ModId}}_Death Received",
       ]
   },
   
   "{{ModId}}_Trash": {
       "Id": "{{ModId}}_Trash",
       "Trigger": "DayEnding",
       "Condition": "PLAYER_STAT Current trashCansChecked 1",
       "Actions": [
           "AddMail Current {{ModId}}_Trash Received",
       ]
   },
    
  },
},

]
}
