{
	"Format": "2.0.0",

	"ConfigSchema": {
		"Enable Mod": {
			"AllowValues": "true, false",
			"Default": "false"
		},
		"ChangeSchedule": {
			"AllowValues": "true, false",
			"Default": true,
			"Description": "是否改变行程"
		},
		"BlackRoute": {
			"AllowValues": "true, false",
			"Default": true,
			"Description": "是否开启黑化路线"
		},
		"DivorceEvents": {
			"AllowValues": "true, false",
			"Default": false,
			"Description": "是否开启离婚事件"
		}

	},

	"Changes": [
		{
			"Action": "Include",
			"FromFile": "content1.json",
			"When": {
				"Enable Mod": true
			}
		}
	]
}