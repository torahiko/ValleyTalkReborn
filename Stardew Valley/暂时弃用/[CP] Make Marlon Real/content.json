{
	"Format": "2.0.0",

	// C O N F I G
	"ConfigSchema": {
		"Override Generic Dialogue": {
			"AllowValues": "false, true",
			"Default": "false"
		},
		"Portrait": {
			"AllowValues": "vanilla, alternate, disabled",
			"Default": "vanilla"
		},
		"call_me_kid": {
			"AllowValues": "false, true",
			"Default": "true"
		}
	},

	// D Y N A M I C   T O K E N S
	"DynamicTokens": [
		{
			"Name": "IsEvenYear",
			"Value": "{{Query: {{Year}} % 2 = 0}}"
		},

