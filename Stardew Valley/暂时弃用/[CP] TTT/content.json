{
    "Format": "2.5.3",
    "ConfigSchema": {
        "EnableMod": {
            "AllowValues": "true, false",
            "Default": "true"
        },
        "Object Number Font": {
            "AllowValues": "Vanilla, Fully-rimed",
            "Default": "Fully-rimed"
        },
        "MAX & HIT": {
            "AllowValues": "Vanilla, Bold",
            "Default": "Bold"
        },
        "Level Up": {
            "AllowValues": "Vanilla, Tweaked",
            "Default": "Tweaked"
        },

    },

    "Changes": [
        //UI - Configurable
        {
            "Action": "EditImage",
            "PatchMode": "Replace",
            "Target": "LooseSprites/Cursors",
            "FromFile":"assets/Num.png",
            "ToArea": { "X": 368, "Y": 56, "Width": 50, "Height": 7 },
            "When": {
                "EnableMod": "true",
                "Object Number Font": "Fully-rimed"
            }
        },
        {
            "Action": "EditImage",
            "PatchMode": "Replace",
            "Target": "LooseSprites/Cursors",
            "FromFile":"assets/MAXHIT.png",
            "ToArea": { "X": 545, "Y": 1913, "Width": 141, "Height": 30 },
            "When": {
                "EnableMod": "true",
                "MAX & HIT": "Bold"
            }
        },
        {
            "Action": "EditImage",
            "PatchMode": "Replace",
            "Target": "LooseSprites/Cursors",
            "FromFile":"assets/LVUP.png",
            "ToArea": { "X": 362, "Y": 84, "Width": 60, "Height": 27 },
            "When": {
                "EnableMod": "true",
                "Level Up": "Tweaked"
            }
        },

        // UI - Unconfigurable
